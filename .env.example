# Copy to .env and fill in your values – never commit .env
RING_CLIENT_ID=your_ring_client_id
RING_CLIENT_SECRET=your_ring_client_secret
RING_ACCESS_TOKEN=your_ring_access_token
RING_REFRESH_TOKEN=your_ring_refresh_token
# Optional: if you want to use Secrets Manager locally, set this instead
# RING_SECRET_NAME=RingArchiveCredentials

ARCHIVE_BUCKET=ringarchive-123456789012-eu-west-2
DYNAMO_TABLE=RingArchiveEvents
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret

# Set to true to enable Bedrock summaries
BEDROCK_SUMMARY_ENABLED=false
